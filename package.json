{
  "name": "expo-mcp-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@modelcontextprotocol/sdk": "^1.29.0",
      "@types/bun": "^1.3.14",
      "@types/node": "^22.18.0",
      "@types/ws": "^8.18.1",
      "memfs": "^4.57.8",
      "prettier": "^3.8.4",
      "typescript": "^6.0.3",
      "ws": "^8.21.0",
      "zod": "^4.4.3"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-universe": "^15.2.0"
  },
  "scripts": {
    "build": "bun run --filter ./packages/mcp-tunnel build && bun run --filter ./packages/expo-mcp build",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "prepublishOnly": "bun run build"
  }
}
